---
import HomeHero from "@/modules/home/home.hero.astro";
import HomePackages from "@/modules/home/home.packages.astro";
import HomeQuickstart from "@/modules/home/home.quickstart.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rune Docs</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: ui-sans-serif, system-ui, sans-serif;
        background: #0b0d10;
        color: #e8eaed;
      }
      body {
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 1.25rem;
        line-height: 1.6;
      }
      code {
        background: #1a1f2a;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
      }
      pre {
        background: #12151c;
        border: 1px solid #1f2430;
        border-radius: 10px;
        padding: 1rem;
        overflow-x: auto;
      }
      a {
        color: #8eb0ff;
      }
    </style>
  </head>
  <body>
    <HomeHero />
    <HomePackages />
    <HomeQuickstart />
  </body>
</html>
