import CliReferenceContent from "@/modules/cli-reference/cli-reference.content.astro";
import HomeFooter from "@/modules/home/home.footer.astro";
import HomeNav from "@/modules/home/home.nav.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>CLI reference — Rune Docs</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+Runic&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<HomeNav current="cli-reference" />
		<main>
			<CliReferenceContent />
		</main>
		<HomeFooter />
	</body>
</html>
