---
const thinkingLevels = [
	"off",
	"minimal",
	"low",
	"medium",
	"high",
	"xhigh",
	"max",
] as const;

const toc = [
	{ id: "overview", label: "Overview" },
	{ id: "global", label: "Global options" },
	{ id: "serve", label: "serve" },
	{ id: "profile", label: "profile" },
	{ id: "link", label: "link" },
	{ id: "health", label: "health" },
	{ id: "help", label: "help" },
] as const;

const profileCommands = [
	{
		id: "profile-list",
		usage: "rune profile list",
		summary: "List every profile under the engine data root.",
		details:
			"Prints glyph, id, and display name as tab-separated columns. Empty store prints “No profiles yet.”",
	},
	{
		id: "profile-show",
		usage: "rune profile show <id>",
		summary: "Show one profile’s metadata and on-disk paths.",
		details:
			"Outputs id, display name, model, thinking level (when set), whether SYSTEM.md exists, and the profile directory.",
	},
	{
		id: "profile-create",
		usage:
			"rune profile create <id> [--name <name>] [--model <provider/id>] [--thinking-level <level>] [--prompt <string>] [--prompt-file <path>]",
		summary: "Create a profile identity and optional defaults.",
		details:
			"<id> is required and must not start with --. --prompt and --prompt-file are mutually exclusive; the file form reads UTF-8 from disk.",
	},
	{
		id: "profile-set",
		usage:
			"rune profile set <id> [--name <name>] [--model <provider/id>] [--thinking-level <level>] [--prompt <string>] [--prompt-file <path>]",
		summary: "Patch fields on an existing profile.",
		details:
			"At least one of --name, --model, --thinking-level, --prompt, or --prompt-file is required.",
	},
	{
		id: "profile-delete",
		usage: "rune profile delete <id> [--force]",
		summary: "Delete a profile by id.",
		details:
			"Pass --force when the API requires an explicit destructive confirm.",
	},
] as const;

const linkCommands = [
	{
		id: "link-list",
		usage: "rune link list",
		summary: "List directed profile links.",
		details:
			"Each line is from -> to with an optional (label). Empty store prints “No links yet.”",
	},
	{
		id: "link-create",
		usage: "rune link create <from> <to> [--label <text>]",
		summary: "Create a directed link between two profile ids.",
		details: "Both <from> and <to> are required positional args.",
	},
] as const;

const overviewSample = `rune serve [--port <n>] [--host <addr>]
rune profile list | show | create | set | delete
rune link list | create
rune health
rune help`;

const globalSample = `rune --url http://127.0.0.1:8787 profile list
RUNE_URL=http://127.0.0.1:9000 bun run rune health`;

const serveUsage = "rune serve [--port <n>] [--host <addr>]";

const serveSample = `❯ bun run rune serve
Rune API listening on http://127.0.0.1:8787
Data root: /path/to/project/.rune`;

const profileSample = `❯ bun run rune profile create researcher --name Researcher --model openai/gpt-5
Created profile researcher

❯ bun run rune profile set researcher --thinking-level medium --prompt-file ./prompts/researcher.md
Updated profile researcher

❯ bun run rune profile show researcher
-	researcher
name	Researcher
model	openai/gpt-5
thinkingLevel	medium
system	SYSTEM.md
dir	.rune/profiles/researcher

❯ bun run rune profile delete researcher --force
Deleted profile researcher`;

const linkSample = `❯ bun run rune link create researcher writer --label "draft pipeline"
Linked researcher -> writer

❯ bun run rune link list
researcher -> writer (draft pipeline)`;

const healthSample = `rune health
rune --url http://127.0.0.1:8787 health`;

const helpSample = `rune help
rune --help
rune -h`;

const flagName = "--name <name>";
const flagModel = "--model <provider/id>";
const flagThinking = "--thinking-level <level>";
const flagPrompt = "--prompt <string>";
const flagPromptFile = "--prompt-file <path>";
const flagUrl = "--url <base>";
const dataRoot = "<cwd>/.rune";
---

<article class="cli-ref site-pad">
	<header class="cli-ref__header">
		<p class="section-label">CLI reference</p>
		<h1 class="cli-ref__title">Command reference</h1>
		<p class="cli-ref__lede">
			The <code>rune</code> binary talks to the local HTTP control plane. Run
			<code>bun run rune …</code> from the monorepo root, or invoke the package bin directly. Most
			commands need <code>rune serve</code> already listening unless noted.
		</p>
	</header>

	<div class="cli-ref__layout">
		<nav class="cli-ref__toc" aria-label="On this page">
			<p class="section-label section-label--muted">On this page</p>
			<ul>
				{
					toc.map((item) => (
						<li>
							<a href={`#${item.id}`}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="cli-ref__body">
			<section id="overview" class="cli-ref__section">
				<h2>Overview</h2>
				<p>
					Entrypoint: <code>packages/cli/src/bin.ts</code> → <code>runCli</code>. Top-level
					commands today:
				</p>
				<pre class="cli-ref__pre" tabindex="0"><code>{overviewSample}</code></pre>
			</section>

			<section id="global" class="cli-ref__section">
				<h2>Global options</h2>
				<p>
					Client commands (<code>profile</code>, <code>link</code>, <code>health</code>) resolve
					the API base URL in this order:
				</p>
				<ol>
					<li><code>{flagUrl}</code> on the command line</li>
					<li><code>RUNE_URL</code> environment variable</li>
					<li>default <code>http://127.0.0.1:8787</code></li>
				</ol>
				<pre class="cli-ref__pre" tabindex="0"><code>{globalSample}</code></pre>
			</section>

			<section id="serve" class="cli-ref__section">
				<h2><code>rune serve</code></h2>
				<p>Start the embedded API + engine process. Blocks until interrupted.</p>
				<pre class="cli-ref__pre" tabindex="0"><code>{serveUsage}</code></pre>
				<table class="cli-ref__table">
					<thead>
						<tr>
							<th scope="col">Flag / env</th>
							<th scope="col">Default</th>
							<th scope="col">Description</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><code>--port</code> / <code>PORT</code></td>
							<td><code>8787</code></td>
							<td>TCP port for the HTTP control plane</td>
						</tr>
						<tr>
							<td><code>--host</code> / <code>HOST</code></td>
							<td><code>127.0.0.1</code></td>
							<td>Bind address</td>
						</tr>
					</tbody>
				</table>
				<p>
					On start the process prints the listen URL and data root <code>{dataRoot}</code>.
				</p>
				<pre class="cli-ref__pre" tabindex="0"><code>{serveSample}</code></pre>
			</section>

			<section id="profile" class="cli-ref__section">
				<h2><code>rune profile</code></h2>
				<p>
					Manage agent profiles (identity, model, thinking level, system prompt). Requires a
					running engine.
				</p>

				{
					profileCommands.map((cmd) => (
						<div class="cli-ref__cmd" id={cmd.id}>
							<h3>
								<code>{cmd.usage}</code>
							</h3>
							<p class="cli-ref__summary">{cmd.summary}</p>
							<p>{cmd.details}</p>
						</div>
					))
				}

				<h3 id="profile-flags">Shared create / set flags</h3>
				<table class="cli-ref__table">
					<thead>
						<tr>
							<th scope="col">Flag</th>
							<th scope="col">Description</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><code>{flagName}</code></td>
							<td>Display name for the profile</td>
						</tr>
						<tr>
							<td><code>{flagModel}</code></td>
							<td>Model id string stored on the profile</td>
						</tr>
						<tr>
							<td><code>{flagThinking}</code></td>
							<td>
								One of{" "}
								{thinkingLevels.map((level, i) => (
									<span>
										{i > 0 ? ", " : ""}
										<code>{level}</code>
									</span>
								))}
							</td>
						</tr>
						<tr>
							<td><code>{flagPrompt}</code></td>
							<td>Inline system prompt text</td>
						</tr>
						<tr>
							<td><code>{flagPromptFile}</code></td>
							<td>
								Load system prompt from a UTF-8 file (not with <code>--prompt</code>)
							</td>
						</tr>
					</tbody>
				</table>

				<pre class="cli-ref__pre" tabindex="0"><code>{profileSample}</code></pre>
			</section>

			<section id="link" class="cli-ref__section">
				<h2><code>rune link</code></h2>
				<p>Wire profiles into a directed flow. Requires a running engine.</p>

				{
					linkCommands.map((cmd) => (
						<div class="cli-ref__cmd" id={cmd.id}>
							<h3>
								<code>{cmd.usage}</code>
							</h3>
							<p class="cli-ref__summary">{cmd.summary}</p>
							<p>{cmd.details}</p>
						</div>
					))
				}

				<pre class="cli-ref__pre" tabindex="0"><code>{linkSample}</code></pre>
			</section>

			<section id="health" class="cli-ref__section">
				<h2><code>rune health</code></h2>
				<p>
					Hit the control-plane health endpoint and print the JSON response (pretty-printed).
					Requires a running engine.
				</p>
				<pre class="cli-ref__pre" tabindex="0"><code>{healthSample}</code></pre>
			</section>

			<section id="help" class="cli-ref__section">
				<h2><code>rune help</code></h2>
				<p>
					Print the built-in usage summary. Also triggered by <code>--help</code>,
					<code>-h</code>, or running <code>rune</code> with no arguments.
				</p>
				<pre class="cli-ref__pre" tabindex="0"><code>{helpSample}</code></pre>
			</section>
		</div>
	</div>
</article>

<style lang="scss">
	.cli-ref {
		padding-top: var(--spacing-16);
		padding-bottom: var(--spacing-24);

		&__header {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-4);
			max-width: 720px;
			margin-bottom: var(--spacing-12);
		}

		&__title {
			margin: 0;
			font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
			font-size: var(--text-3xl);
			font-weight: var(--font-weight-semibold);
			letter-spacing: var(--tracking-tight);
			line-height: 44px;
			color: var(--color-ink);
		}

		&__lede {
			margin: 0;
			font-size: var(--text-md);
			line-height: var(--leading-body);
			color: var(--color-ink-dim);

			code {
				font-family: var(--font-mono), ui-monospace, monospace;
				font-size: 0.92em;
				color: var(--color-ink);
			}
		}

		&__layout {
			display: grid;
			grid-template-columns: 200px minmax(0, 1fr);
			gap: var(--spacing-16);
			align-items: start;

			@media (max-width: 900px) {
				grid-template-columns: 1fr;
				gap: var(--spacing-8);
			}
		}

		&__toc {
			position: sticky;
			top: 96px;
			display: flex;
			flex-direction: column;
			gap: var(--spacing-4);

			@media (max-width: 900px) {
				position: static;
			}

			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			a {
				font-family: var(--font-mono), ui-monospace, monospace;
				font-size: var(--text-sm);
				color: var(--color-muted);
				text-decoration: none;

				&:hover {
					color: var(--color-ink-dim);
					text-decoration: none;
				}
			}
		}

		&__body {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-12);
			max-width: 760px;
			min-width: 0;
		}

		&__section {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-4);
			scroll-margin-top: 96px;

			h2 {
				margin: 0;
				font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
				font-size: var(--text-xl);
				font-weight: var(--font-weight-semibold);
				line-height: var(--leading-heading);
				color: var(--color-ink);

				code {
					font-family: var(--font-mono), ui-monospace, monospace;
					font-size: 0.9em;
				}
			}

			h3 {
				margin: var(--spacing-4) 0 0;
				font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
				font-size: var(--text-lg);
				font-weight: var(--font-weight-semibold);
				line-height: 1.3;
				color: var(--color-ink);

				code {
					font-family: var(--font-mono), ui-monospace, monospace;
					font-size: 0.85em;
					font-weight: var(--font-weight-medium);
					word-break: break-word;
				}
			}

			p,
			li {
				margin: 0;
				color: var(--color-ink-dim);
				font-size: var(--text-base);
				line-height: var(--leading-body);
			}

			ol {
				margin: 0;
				padding-left: 1.25rem;
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			code {
				font-family: var(--font-mono), ui-monospace, monospace;
				font-size: 0.92em;
				color: var(--color-ink);
			}
		}

		&__cmd {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-2);
			padding: var(--spacing-5) 0;
			border-top: 1px solid var(--color-line);
			scroll-margin-top: 96px;

			&:first-of-type {
				border-top: none;
				padding-top: 0;
			}
		}

		&__summary {
			color: var(--color-ink) !important;
			font-weight: var(--font-weight-medium);
		}

		&__pre {
			margin: 0;
			padding: var(--spacing-5);
			background: var(--color-panel);
			border: 1px solid var(--color-line);
			border-radius: var(--radius-lg);
			overflow-x: auto;
			font-family: var(--font-mono), ui-monospace, monospace;
			font-size: var(--text-sm);
			line-height: 1.6;
			color: var(--color-ink);

			code {
				font-family: inherit;
				font-size: inherit;
				color: inherit;
			}
		}

		&__table {
			width: 100%;
			border-collapse: collapse;
			font-size: var(--text-sm);

			th,
			td {
				text-align: left;
				vertical-align: top;
				padding: var(--spacing-3) var(--spacing-4);
				border-bottom: 1px solid var(--color-line);
			}

			th {
				font-family: var(--font-mono), ui-monospace, monospace;
				font-size: var(--text-xs);
				font-weight: var(--font-weight-medium);
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
				background: var(--color-panel);
			}

			td {
				color: var(--color-ink-dim);

				code {
					font-family: var(--font-mono), ui-monospace, monospace;
					font-size: 0.92em;
					color: var(--color-ink);
				}
			}
		}
	}
</style>
