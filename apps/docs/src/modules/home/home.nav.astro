---
interface Props {
	/** Current page key for active link styling and href resolution. */
	current?: "home" | "cli-reference";
}

const { current = "home" } = Astro.props;
const homePrefix = current === "home" ? "" : "/";

const links = [
	{
		label: "Get started",
		href: `${homePrefix}#quickstart`,
		key: "quickstart",
	},
	{ label: "Profiles", href: `${homePrefix}#profiles`, key: "profiles" },
	{ label: "Links", href: `${homePrefix}#links`, key: "links" },
	{ label: "Engine", href: `${homePrefix}#engine`, key: "engine" },
	{
		label: "CLI",
		href: current === "cli-reference" ? "/cli-reference" : `${homePrefix}#cli`,
		key: "cli",
	},
] as const;

const activeKey = current === "cli-reference" ? "cli" : "quickstart";
---

<header class="home-nav site-pad">
	<a class="home-nav__brand" href="/">
		<span class="home-nav__mark" aria-hidden="true">
			<svg width="40" height="40" viewBox="0 0 40 40" fill="none">
				<circle cx="20" cy="20" r="18" stroke="var(--color-accent-dim)" stroke-width="1.5"
				></circle>
				<circle cx="20" cy="20" r="12" stroke="var(--color-accent)" stroke-width="1.5"
				></circle>
				<line
					x1="20"
					y1="4"
					x2="20"
					y2="8"
					stroke="var(--color-accent-bright)"
					stroke-width="1.5"
					stroke-linecap="round"></line>
				<line
					x1="20"
					y1="32"
					x2="20"
					y2="36"
					stroke="var(--color-accent-bright)"
					stroke-width="1.5"
					stroke-linecap="round"></line>
				<line
					x1="4"
					y1="20"
					x2="8"
					y2="20"
					stroke="var(--color-accent-bright)"
					stroke-width="1.5"
					stroke-linecap="round"></line>
				<line
					x1="32"
					y1="20"
					x2="36"
					y2="20"
					stroke="var(--color-accent-bright)"
					stroke-width="1.5"
					stroke-linecap="round"></line>
			</svg>
			<span class="home-nav__runic">ᚱ</span>
		</span>
		<span class="home-nav__wordmark">RUNE</span>
		<span class="home-nav__divider" aria-hidden="true"></span>
		<span class="home-nav__product">Docs</span>
	</a>

	<nav class="home-nav__links" aria-label="Documentation">
		{
			links.map((link) => (
				<a
					class:list={["home-nav__link", { "home-nav__link--active": link.key === activeKey }]}
					href={link.href}
					aria-current={link.key === activeKey ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<a class="btn-primary" href={`${homePrefix}#quickstart`}>Get started</a>
</header>

<style lang="scss">
	.home-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-6);
		width: 100%;
		padding-block: 24px;
		border-bottom: 1px solid var(--color-line);
		background: var(--color-void);
		position: sticky;
		top: 0;
		z-index: 10;

		&__brand {
			display: inline-flex;
			align-items: center;
			gap: var(--spacing-3);
			color: inherit;
			text-decoration: none;
			flex-shrink: 0;

			&:hover {
				text-decoration: none;
			}
		}

		&__mark {
			position: relative;
			display: inline-flex;
			width: 40px;
			height: 40px;
			flex-shrink: 0;
		}

		&__runic {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: "Noto Sans Runic", var(--font-display), sans-serif;
			font-size: 26px;
			line-height: 1;
			color: var(--color-accent-bright);
		}

		&__wordmark {
			font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
			font-size: 20px;
			font-weight: var(--font-weight-semibold);
			letter-spacing: var(--tracking-normal);
			color: var(--color-ink);
		}

		&__divider {
			width: 1px;
			height: 18px;
			background: var(--color-line-strong);
			flex-shrink: 0;
		}

		&__product {
			font-family: var(--font-mono), ui-monospace, monospace;
			font-size: var(--text-xs);
			font-weight: var(--font-weight-medium);
			letter-spacing: var(--tracking-wider);
			text-transform: uppercase;
			color: var(--color-muted);
		}

		&__links {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--spacing-10);
			flex: 1;

			@media (max-width: 900px) {
				gap: var(--spacing-6);
			}
		}

		&__link {
			font-family: var(--font-mono), ui-monospace, monospace;
			font-size: var(--text-sm);
			font-weight: var(--font-weight-medium);
			letter-spacing: var(--tracking-wide);
			text-transform: uppercase;
			color: var(--color-muted);
			text-decoration: none;
			white-space: nowrap;

			&:hover {
				color: var(--color-ink-dim);
				text-decoration: none;
			}

			&--active {
				color: var(--color-ink-dim);
			}
		}
	}
</style>
